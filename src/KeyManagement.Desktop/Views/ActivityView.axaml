<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyManagement.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="840"
             x:Class="KeyManagement.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

  <Grid RowDefinitions="Auto,*" Margin="20">

    <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="SHOW" />
          <ComboBox ItemsSource="{Binding Types}"
                    SelectedItem="{Binding SelectedType}"
                    MinWidth="210"
                    Margin="0,4,0,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding Converter={x:Static vm:ActivityConverters.TypeWord}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Classes="label" Text="PERIOD" />
          <ComboBox ItemsSource="{Binding Windows}"
                    SelectedItem="{Binding SelectedWindow}"
                    MinWidth="160"
                    Margin="0,4,0,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Int32">
                <TextBlock Text="{Binding Converter={x:Static vm:ActivityConverters.WindowWord}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <TextBlock Grid.Column="2"
                   Classes="caption"
                   Text="{Binding ResultSummary}"
                   VerticalAlignment="Bottom"
                   Margin="18,0,0,10" />

        <Button Grid.Column="3"
                Classes="secondary"
                Content="Export"
                Margin="0,0,10,0"
                Command="{Binding ExportCommand}" />

        <Button Grid.Column="4"
                Classes="secondary"
                Content="Search"
                VerticalAlignment="Bottom"
                Margin="14,0,0,4"
                Command="{Binding SearchCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel">
      <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="tableHeader">
          <Grid ColumnDefinitions="180,190,*,100">
            <TextBlock Grid.Column="0" Text="WHEN" />
            <TextBlock Grid.Column="1" Text="WHAT" />
            <TextBlock Grid.Column="2" Text="DETAIL" />
            <TextBlock Grid.Column="3" Text="COMMAND" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Records}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityRowViewModel">
                <Border Classes="tableRow">
                  <Grid ColumnDefinitions="180,190,*,100">
                    <TextBlock Grid.Column="0" Classes="mono muted" Text="{Binding When}"
                               VerticalAlignment="Center" />

                    <!-- A refusal or a fault is marked, because those are the rows anyone
                         reading a trail is usually looking for. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                                VerticalAlignment="Center">
                      <Border Width="3" Height="14" CornerRadius="2"
                              Background="{DynamicResource StateFaultBrush}"
                              IsVisible="{Binding IsRefusal}" />
                      <TextBlock Text="{Binding What}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Correlation}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>

</UserControl>
