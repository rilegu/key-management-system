<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyManagement.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="840"
             x:Class="KeyManagement.Desktop.Views.AlarmsView"
             x:DataType="vm:AlarmsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="20">

    <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Path Classes="icon large"
                Data="{StaticResource AlertIcon}"
                Fill="{DynamicResource StateOutBrush}" />
          <StackPanel>
            <TextBlock Classes="subtitle" Text="Alarms" />
            <TextBlock Classes="caption" Text="{Binding ResultSummary}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <CheckBox Grid.Column="2"
                  Content="Outstanding only"
                  IsChecked="{Binding ActiveOnly}"
                  VerticalAlignment="Center"
                  Margin="0,0,14,0" />

        <Button Grid.Column="3"
                Classes="secondary"
                Content="Reload"
                VerticalAlignment="Center"
                Command="{Binding LoadCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel">
      <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="tableHeader">
          <Grid ColumnDefinitions="150,110,190,*,160,130">
            <TextBlock Grid.Column="0" Text="RAISED" />
            <TextBlock Grid.Column="1" Text="SEVERITY" />
            <TextBlock Grid.Column="2" Text="WHAT" />
            <TextBlock Grid.Column="3" Text="DETAIL" />
            <TextBlock Grid.Column="4" Text="ACKNOWLEDGED BY" />
            <TextBlock Grid.Column="5" Text="" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Alarms}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlarmRowViewModel">
                <Border Classes="tableRow">
                  <Grid ColumnDefinitions="150,110,190,*,160,130">
                    <TextBlock Grid.Column="0" Classes="mono muted" Text="{Binding When}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" Classes="chip"
                            Classes.fault="{Binding IsCritical}"
                            Classes.out="{Binding IsWarning}"
                            Classes.released="{Binding IsInformation}">
                      <TextBlock Text="{Binding SeverityWord}" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding What}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Classes="caption" Text="{Binding AcknowledgedBy}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="5" Classes="secondary" Content="Acknowledge"
                            Padding="10,4"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding IsActive}"
                            Command="{Binding $parent[ItemsControl].((vm:AlarmsViewModel)DataContext).AcknowledgeCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>

</UserControl>
