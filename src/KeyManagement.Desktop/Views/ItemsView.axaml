<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyManagement.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="840"
             x:Class="KeyManagement.Desktop.Views.ItemsView"
             x:DataType="vm:ItemsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="20">

    <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="340" HorizontalAlignment="Left">
          <TextBlock Classes="label" Text="SEARCH" />
          <TextBox Text="{Binding SearchText}"
                   PlaceholderText="Reference or description"
                   Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Classes="label" Text="GROUP" />
          <ComboBox ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}"
                    MinWidth="180"
                    Margin="0,4,0,0" />
        </StackPanel>

        <CheckBox Grid.Column="2"
                  Content="Out of cabinet only"
                  IsChecked="{Binding OutOnly}"
                  VerticalAlignment="Bottom"
                  Margin="18,0,0,6" />

        <TextBlock Grid.Column="3"
                   Classes="caption"
                   Text="{Binding ResultSummary}"
                   VerticalAlignment="Bottom"
                   Margin="18,0,0,10" />

        <Button Grid.Column="4"
                Classes="secondary"
                Content="Reload"
                VerticalAlignment="Bottom"
                Margin="14,0,0,4"
                Command="{Binding LoadCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="panel">
      <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="tableHeader">
          <Grid ColumnDefinitions="110,*,150,120,80,130,150,170">
            <TextBlock Grid.Column="0" Text="REFERENCE" />
            <TextBlock Grid.Column="1" Text="DESCRIPTION" />
            <TextBlock Grid.Column="2" Text="GROUP" />
            <TextBlock Grid.Column="3" Text="CABINET" />
            <TextBlock Grid.Column="4" Text="POSITION" />
            <TextBlock Grid.Column="5" Text="STATE" />
            <TextBlock Grid.Column="6" Text="HELD BY" />
            <TextBlock Grid.Column="7" Text="" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemRowViewModel">
                <Border Classes="tableRow">
                  <Grid ColumnDefinitions="110,*,150,120,80,130,150,170">
                    <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Reference}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding GroupName}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding CabinetName}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Classes="mono muted" Text="{Binding Position}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="5" Classes="chip"
                            Classes.in="{Binding IsIn}"
                            Classes.out="{Binding IsOut}"
                            Classes.released="{Binding IsReleased}"
                            Classes.fault="{Binding IsFault}">
                      <TextBlock Text="{Binding StateWord}" />
                    </Border>

                    <TextBlock Grid.Column="6" Classes="caption" Text="{Binding HeldBy}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Classes="secondary" Content="Release" Padding="10,4"
                              IsVisible="{Binding CanRequest}"
                              Command="{Binding $parent[ItemsControl].((vm:ItemsViewModel)DataContext).RequestCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="secondary" Content="Return" Padding="10,4"
                              IsVisible="{Binding CanReturn}"
                              Command="{Binding $parent[ItemsControl].((vm:ItemsViewModel)DataContext).ReturnCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>

</UserControl>
