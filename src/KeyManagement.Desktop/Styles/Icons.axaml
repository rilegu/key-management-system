<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icon geometry, drawn on a 24x24 grid and scaled where it is used. Kept as resources so a
    glyph is named rather than pasted: the key appears on the brand mark, the navigation rail
    and every position tile, and it should be the same key in all three.

    Nothing here is decorative. On the board the key glyph carries the same message as the
    colour and the state word, which is what lets a position be read at a glance.
  -->

  <!-- A key, seen side on. The application mark, and the glyph for an item. -->
  <StreamGeometry x:Key="KeyIcon">M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z</StreamGeometry>

  <!-- An empty ring: a position with nothing in it. -->
  <StreamGeometry x:Key="EmptyPositionIcon">M12 4c-4.41 0-8 3.59-8 8s3.59 8 8 8 8-3.59 8-8-3.59-8-8-8zm0 14c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z</StreamGeometry>

  <!-- A grid of positions: the board. -->
  <StreamGeometry x:Key="BoardIcon">M3 3v8h8V3H3zm6 6H5V5h4v4zm-6 4v8h8v-8H3zm6 6H5v-4h4v4zm4-16v8h8V3h-8zm6 6h-4V5h4v4zm-6 4v8h8v-8h-8zm6 6h-4v-4h4v4z</StreamGeometry>

  <!-- A clock turning back: the activity trail. -->
  <StreamGeometry x:Key="ActivityIcon">M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</StreamGeometry>

  <!-- A warning triangle: a fault, or custody that cannot be established. -->
  <StreamGeometry x:Key="AlertIcon">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>

</ResourceDictionary>
